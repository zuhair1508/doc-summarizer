# Supabase (Project Settings -> API). The service role key stays server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: comma-separated fallback list of models, tried in order.
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free

# Optional: new summaries per IP per hour (default 5).
# RATE_LIMIT_PER_HOUR=5

# Vercel Cron sends this as a Bearer token to /api/cron/cleanup. Any long random string.
CRON_SECRET=
